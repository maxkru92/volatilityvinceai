node_modules/
.DS_Store
*.log
.vercel
.env
.env.local
# Exclude ALL raw _render.py pack artefacts; KEEP deployed canonical
# filenames (favicon.ico, apple-touch-icon.png, kc-<variant>.svg, etc.)
# tracked because Vercel serves whatever is in git on main.
kc-*.png
kc-*.svg
kc-*.ico
kc-*.xml
manifest-*.webmanifest
# keep public/ tracked even when empty between scaffolds
!public/.gitkeep
